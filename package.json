{
  "name": "illegal-fishing-backend",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest",
    "test:verbose": "jest --verbose",
    "test:coverage": "jest --coverage",
    "test:integration": "jest --config jest.integration.config.js",
    "test:integration:coverage": "jest --config jest.integration.config.js --coverage",
    "test:all": "npm run test && npm run test:integration",
    "generate:artillery": "node scripts/generate-artillery-configs.js",
    "perf:artillery": "dotenv -e .env -- artillery run artillery/get-api-districts.yml",
    "perf:artillery:login": "dotenv -e .env -- artillery run artillery/post-api-auth-login.yml",
    "perf:artillery:all": "node scripts/run-artillery-all.js",
    "perf:artillery:report": "dotenv -e .env -- artillery run --output artillery-report.json artillery/get-api-districts.yml && artillery report artillery-report.json"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@google/genai": "^1.42.0",
    "@sendgrid/mail": "^8.1.6",
    "axios": "^1.13.5",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^1.41.3",
    "cors": "^2.8.6",
    "dotenv": "^17.2.4",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.1.6",
    "multer": "^2.0.2",
    "nodemailer": "^8.0.1",
    "pdfkit": "^0.17.2",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "twilio": "^5.12.2"
  },
  "devDependencies": {
    "artillery": "^2.0.30",
    "dotenv-cli": "^11.0.0",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^11.0.1",
    "nodemon": "^3.1.11",
    "supertest": "^7.2.2"
  }
}
